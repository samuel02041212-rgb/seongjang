generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  registrationApproved  Boolean   @default(false)
  isAdmin               Boolean   @default(false)
  gender                String?
  birthDate             DateTime?
  church                String    @default("")
  statusMessage         String    @default("")
  signupSource          String    @default("")
  accounts              Account[]
  sessions              Session[]
  posts                 Post[]
  comments              Comment[]
  chatRoomsA            ChatRoom[] @relation("ChatRoomA")
  chatRoomsB            ChatRoom[] @relation("ChatRoomB")
  chatMessages          ChatMessage[] @relation("ChatMessages")
  bookmarkFolders       BookmarkFolder[]
  postBookmarks         PostBookmark[]
  adminGroups           SmallGroup[]         @relation("GroupAdmin")
  groupMembers          GroupMember[]
  groupCreationRequests GroupCreationRequest[]
  groupJoinRequests     GroupJoinRequest[]
  groupChatMessages     GroupChatMessage[] @relation("GroupChatMessages")
  userTodos             UserTodo[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum PostKind {
  MEDITATION
  ANNOUNCEMENT
}

model Post {
  id               String   @id @default(cuid())
  authorId         String
  authorName       String
  title            String   @default("")
  content          String
  imageUrls        String[] @default([])
  imagesLarge      Boolean  @default(false)
  bibleRef         String   @default("")
  bibleBookKey     String?
  otherReadingRef  String?
  bibleChapterStart Int?
  bibleVerseStart   Int?
  bibleChapterEnd   Int?
  bibleVerseEnd     Int?
  bibleReadingRanges Json?
  kind             PostKind @default(MEDITATION)
  feedPinned       Boolean  @default(false)
  likedBy          String[] @default([])
  visibleGroupIds  String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  bookmarks PostBookmark[]

  @@index([createdAt(sort: Desc)])
  @@index([visibleGroupIds])
}

model UserTodo {
  id        String   @id @default(cuid())
  userId    String
  date      String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatRoom {
  id            String        @id @default(cuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime?
  lastReadAtA   DateTime?
  lastReadAtB   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userA    User          @relation("ChatRoomA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("ChatRoomB", fields: [userBId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model GlobalScheduleEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#ffcd38")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt, endAt])
}

model BookmarkFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks PostBookmark[]

  @@index([userId, sortOrder])
}

model PostBookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  folderId  String
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  folder BookmarkFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, folderId])
  @@index([userId, folderId])
  @@index([postId])
}

model SmallGroup {
  id            String   @id @default(cuid())
  name          String
  image         String?
  statusMessage String   @default("")
  description   String   @default("")
  adminId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin        User               @relation("GroupAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  chatMessages GroupChatMessage[]

  @@index([name])
  @@index([adminId])
}

model GroupMember {
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model GroupCreationRequest {
  id           String    @id @default(cuid())
  requesterId  String
  name         String
  description  String    @default("")
  image        String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
}

model GroupJoinRequest {
  id         String    @id @default(cuid())
  userId     String
  groupId    String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model GroupChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  kind      String   @default("text")
  content   String
  createdAt DateTime @default(now())

  group  SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User       @relation("GroupChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}
