# Local dev using the SAME Neon DB as production:
# 1) Vercel → Project → Settings → Environment Variables
# 2) Copy DATABASE_URL (pooled) and paste below.
# 3) Copy DIRECT_URL if you use Neon "direct" for prisma migrate (or omit).
# 4) Copy AUTH_SECRET from Vercel into AUTH_SECRET here (same secret = same signing; keep AUTH_URL for local only).
# 5) AUTH_URL must stay http://localhost:3000 for local next dev.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Kakao login (REST API key + Client secret from Developers → 앱 → 플랫폼 키 → REST API 키)
# Vercel Production: set AUTH_KAKAO_ID, AUTH_KAKAO_SECRET, AUTH_URL=https://YOUR-DOMAIN (no trailing slash)
# Kakao Redirect URI: https://YOUR-DOMAIN/api/auth/callback/kakao (register under REST API key, not JS key)
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
# Optional: local/dev only — prod에서는 설정하지 마세요 (설정 시 카카오 가입도 자동 승인됨).
REGISTRATION_AUTO_APPROVE=
AUTH_DEV_BYPASS=

# Optional: Vercel Blob for image uploads in production (Dashboard → Storage → create Blob → token).
# Without this, local dev saves under public/uploads; production returns 503 until configured.
BLOB_READ_WRITE_TOKEN=
